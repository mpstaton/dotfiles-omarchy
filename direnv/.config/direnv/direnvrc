# nix-direnv: a faster, cached `use flake` / `use nix` that pins the devshell
# as a GC root so `nix store gc` doesn't wipe it.
# Installed with: nix profile add nixpkgs#nix-direnv
if [[ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]]; then
  source "$HOME/.nix-profile/share/nix-direnv/direnvrc"
fi
